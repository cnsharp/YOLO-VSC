        "when": "yolo.agentInstalled.antigravity"
      },
      {
        "path": "./agents/mistral-vibe.agent.md",
        "when": "yolo.agentInstalled.mistral_vibe"
      },
      {
        "path": "./agents/kilo.agent.md",
        "when": "yolo.agentInstalled.kilo"
      },
      {
        "path": "./agents/hermes.agent.md",
        "when": "yolo.agentInstalled.hermes"
      },
      {
        "path": "./agents/pi.agent.md",
        "when": "yolo.agentInstalled.pi"
      },
      {
        "path": "./agents/droid.agent.md",
        "when": "yolo.agentInstalled.droid"
      },
      {
        "path": "./agents/aug.agent.md",
        "when": "yolo.agentInstalled.aug"
      },
      {
