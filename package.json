{
  "name": "agentyolo",
  "displayName": "Agent YOLO",
  "description": "Launch AI CLI agents (Claude Code, Codex, Cursor CLI, …) in an embedded terminal with clickable file/type links.",
  "version": "1.1.1",
  "publisher": "cnsharp",
  "repository": {
    "type": "git",
    "url": "https://github.com/cnsharp/yolo-vsc.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onView:yolo.panel",
    "onCommand:yolo.openPanel",
    "onCommand:yolo.openManager"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "configuration": {
      "title": "Agent YOLO",
      "properties": {
        "yolo.agents": {
          "type": "array",
          "markdownDescription": "%config.yolo.agents.markdownDescription%",
          "items": {
            "type": "object",
            "required": [
              "command"
            ],
            "additionalProperties": false,
            "defaultSnippets": [
              {
                "label": "Override a built-in agent",
                "description": "Change only the fields you set on an agent from agents.json, matched by command.",
                "body": {
                  "command": "${1:claude}",
                  "resumeFlag": "${2:--continue}"
                }
              },
              {
                "label": "Hide a built-in agent",
                "description": "Keep the agent in agents.json but stop showing it in the panel.",
                "body": {
                  "command": "${1:gemini}",
                  "enabled": false
                }
              },
              {
                "label": "Add a custom agent",
                "description": "Add an agent that is not in agents.json (command only is enough).",
                "body": {
                  "command": "${1:my-agent}",
                  "displayName": "${2:My Agent}",
                  "baseArgs": "${3:}",
                  "skipFlag": "${4:}",
                  "resumeFlag": "${5:}"
                }
              }
            ],
            "properties": {
              "command": {
                "type": "string",
                "markdownDescription": "CLI binary launched in the terminal (also used for PATH detection). Required. Match a built-in's `command` to override it; use a new one to add a custom agent.",
                "examples": [
                  "claude",
                  "codex",
                  "cursor-agent"
                ]
              },
              "displayName": {
                "type": "string",
                "markdownDescription": "Name shown in the panel. Defaults to `command` for custom agents."
              },
              "baseArgs": {
                "type": "string",
                "markdownDescription": "Space-separated arguments always passed to the command, before any mode flag (e.g. `agent` for `cursor-agent`, `run` for `kilo`).",
                "examples": [
                  "agent",
                  "run",
                  "--auto-approve true"
                ]
              },
              "skipFlag": {
                "type": "string",
                "markdownDescription": "Space-separated flag appended when YOLO (skip-permissions) mode is on (e.g. `--dangerously-skip-permissions` for Claude, `--yolo` for Gemini). Leave it empty to launch with no auto-approve flag.",
                "examples": [
                  "--dangerously-skip-permissions",
                  "--full-auto",
                  "--yolo",
                  "--permission-mode bypassPermissions",
                  "--allow-all-tools --allow-all-paths"
                ]
              },
              "resumeFlag": {
                "type": "string",
                "markdownDescription": "Space-separated flag appended when Resume mode is on, to continue the most recent session (e.g. `-r` for Claude, `--resume` for Codex and Cursor). Omit it and the agent launches normally even in Resume mode.",
                "examples": [
                  "-r",
                  "--resume",
                  "--continue"
                ]
              },
              "iconFile": {
                "type": "string",
                "markdownDescription": "Icon filename under the extension's `media/agents` folder (e.g. `claude.png`). If omitted, a default terminal icon is used.",
                "examples": [
                  "claude.png",
                  "codex.png"
                ]
              },
              "enabled": {
                "type": "boolean",
                "default": true,
                "markdownDescription": "Set to `false` to hide an agent without deleting its entry."
              },
              "id": {
                "type": "string",
                "markdownDescription": "Optional stable id (defaults to `command`). An override may also match a built-in by its `id`."
              }
            }
          }
        },
        "yolo.permissionRules": {
          "type": "array",
          "default": [],
          "markdownDescription": "%config.yolo.permissionRules.markdownDescription%",
          "items": {
            "type": "object",
            "required": [
              "agentId",
              "flag"
            ],
            "properties": {
              "agentId": {
                "type": "string",
                "markdownDescription": "Agent `command` or `id` this rule applies to.",
                "examples": [
                  "claude",
                  "codex"
                ]
              },
              "flag": {
                "type": "string",
                "markdownDescription": "Space-separated flag appended when YOLO mode is on.",
                "examples": [
                  "--dangerously-skip-permissions",
                  "--full-auto",
                  "--yolo"
                ]
              }
            }
          }
        },
        "yolo.skipEnabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.yolo.skipEnabled.markdownDescription%"
        },
        "yolo.resumeMode": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.yolo.resumeMode.markdownDescription%"
        },
        "yolo.suppressSkipWarning": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.yolo.suppressSkipWarning.markdownDescription%"
        },
        "yolo.lastAgentId": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.yolo.lastAgentId.markdownDescription%"
        },
        "yolo.agentResumeFlags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "%config.yolo.agentResumeFlags.markdownDescription%"
        },
        "yolo.agentBaseArgs": {
          "type": "object",
          "default": {},
          "markdownDescription": "%config.yolo.agentBaseArgs.markdownDescription%"
        },
        "yolo.installedCommands": {
          "type": "array",
          "default": [],
          "markdownDescription": "%config.yolo.installedCommands.markdownDescription%"
        },
        "yolo.shell": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.yolo.shell.markdownDescription%"
        },
        "yolo.shellArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.yolo.shellArgs.markdownDescription%"
        }
      }
    },
    "commands": [
      {
        "command": "yolo.openPanel",
        "title": "%command.openPanel.title%",
        "category": "Agent YOLO",
        "icon": "$(y)"
      },
      {
        "command": "yolo.openManager",
        "title": "%command.openManager.title%",
        "category": "Agent YOLO",
        "icon": "$(robot)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yolo-agents",
          "title": "%viewsContainers.yolo-agents.title%",
          "icon": "media/icons/panelIcon.png"
        }
      ]
    },
    "views": {
      "yolo-agents": [
        {
          "icon": "media/icons/panelIcon.png",
          "type": "webview",
          "id": "yolo.panel",
          "name": "%views.yolo.panel.name%",
          "retainContextWhenHidden": true
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "postinstall": "node scripts/ensure-node-pty-exec.cjs",
    "build": "npm run compile && npm run build:webview",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "esbuild src/webview/panel.ts src/webview/manage.ts --bundle --outdir=media/dist --loader:.css=css --sourcemap",
    "watch:webview": "npm run build:webview -- --watch",
    "test": "node --test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0",
    "esbuild": "^0.21.0"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  }
}
