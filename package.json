  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "postinstall": "node scripts/ensure-node-pty-exec.cjs",
    "generate": "node scripts/generate-native-chat-agents.cjs",
    "build": "npm run generate && npm run compile && npm run build:webview && node scripts/ensure-node-pty-exec.cjs",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "esbuild src/webview/panel.ts src/webview/manage.ts --bundle --outdir=media/dist --loader:.css=css --sourcemap",
    "watch:webview": "npm run build:webview -- --watch",
    "test": "node --test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^5.4.0",
    "esbuild": "^0.21.0"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  }
}
